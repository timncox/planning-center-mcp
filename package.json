{
  "name": "planning-center-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol server for Planning Center Online — lets Claude work directly with your church's PCO data",
  "main": "dist/index.js",
  "bin": {
    "planning-center-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "INSTALL.md",
    "REMOTE_DEPLOY.md",
    "RELEASE_NOTES.md",
    "TODO.md",
    "public/logo.png",
    "drizzle"
  ],
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "build": "tsc && mkdir -p dist/public && cp public/logo.png dist/public/logo.png",
    "prepack": "pnpm run build",
    "dev": "tsx watch src/index.ts",
    "dev:remote": "tsx watch src/remote.ts",
    "start": "node dist/index.js",
    "start:remote": "node dist/remote.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && playwright test",
    "test:e2e": "playwright test",
    "test:connection": "tsx src/test-connection.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "keywords": [
    "mcp",
    "planning-center",
    "church",
    "model-context-protocol",
    "claude"
  ],
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@neondatabase/serverless": "^0.10.4",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.12.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
